# Ghostty config, ported 2026-10-01 from the iTerm2 default profile
# ("Material Dark Theme (synchronized with VSCode)" in ~/Dropbox/iTerm).
# Linked to ~/.config/ghostty/config by install.sh. Reload: cmd+shift+,

# --- Font (iTerm: FiraCode-Regular 14, ligatures on, vertical spacing 1.6)
font-family = Fira Code
font-size = 14
adjust-cell-height = 60%

# --- Colors (iTerm palette, sRGB)
background = #212121
foreground = #eeffff
bold-color = #c4c7d1
selection-background = #616161
selection-foreground = #eeffff
cursor-color = #ffcb6b
cursor-text = #ffcb6b
palette = 0=#000000
palette = 1=#cd3131
palette = 2=#0dbc79
palette = 3=#e5e510
palette = 4=#2472c8
palette = 5=#bc3fbc
palette = 6=#11a8cd
palette = 7=#e5e5e5
palette = 8=#666666
palette = 9=#f14c4c
palette = 10=#23d18b
palette = 11=#f5f543
palette = 12=#3b8eea
palette = 13=#d670d6
palette = 14=#29b8db
palette = 15=#e5e5e5

# --- Cursor (iTerm: underline, blinking)
cursor-style = underline
cursor-style-blink = true

# --- Window (iTerm: 120x40, minimal tab style, dim inactive panes ~48%)
window-width = 120
window-height = 40
macos-titlebar-style = tabs
unfocused-split-opacity = 0.52
window-save-state = never

# --- Behaviour
# iTerm had unlimited scrollback; Ghostty caps at a byte count (default 10MB).
scrollback-limit = 200000000
# iTerm: visual bell only, no sound
bell-features = no-audio,no-system,attention,title
# iTerm: no "prompt before closing", no prompt on quit
confirm-close-surface = false
# iTerm: "Applications in terminal may access clipboard" was on
clipboard-read = allow
copy-on-select = true

# --- Herdr: release these so they reach herdr's own bindings (see config/herdr)
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+k=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+shift+arrow_up=unbind
keybind = super+shift+arrow_down=unbind
